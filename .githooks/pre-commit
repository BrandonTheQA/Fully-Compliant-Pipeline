#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook to run unit tests and minikube deployment tests
# Skip with: SKIP_MINIKUBE_TESTS=1 git commit

if [ "${SKIP_MINIKUBE_TESTS:-}" = "1" ]; then
  echo "Skipping minikube tests (SKIP_MINIKUBE_TESTS=1)"
  exit 0
fi

# Get the script directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
DEPLOY_SCRIPT="$REPO_ROOT/scripts/deploy-minikube.sh"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}Running unit tests and minikube deployment tests before commit...${NC}"

# Run unit tests for Java services
run_service_tests() {
  local service_dir="$1"
  local service_name="$2"
  
  echo -e "${YELLOW}Running unit tests for $service_name service...${NC}"
  cd "$service_dir"
  
  if ! mvn test -q; then
    echo -e "${RED}✗ Unit tests failed for $service_name service${NC}"
    return 1
  fi
  
  echo -e "${GREEN}✓ Unit tests passed for $service_name service${NC}"
  return 0
}

# Run unit tests for UI
run_ui_tests() {
  echo -e "${YELLOW}Running unit tests for UI...${NC}"
  cd "$REPO_ROOT/ui"
  
  if ! npm test -- --passWithNoTests --silent; then
    echo -e "${RED}✗ Unit tests failed for UI${NC}"
    return 1
  fi
  
  echo -e "${GREEN}✓ Unit tests passed for UI${NC}"
  return 0
}

# Run all unit tests
echo -e "${YELLOW}Running unit tests...${NC}"

# Check if Maven is available
if ! command -v mvn >/dev/null 2>&1; then
  echo -e "${RED}Error: Maven (mvn) is not installed${NC}"
  exit 1
fi

# Check if npm is available
if ! command -v npm >/dev/null 2>&1; then
  echo -e "${RED}Error: npm is not installed${NC}"
  exit 1
fi

# Run tests for each service
SERVICES=(
  "$REPO_ROOT/api/services/user:user"
  "$REPO_ROOT/api/services/product:product"
  "$REPO_ROOT/api/services/order:order"
)

for service_info in "${SERVICES[@]}"; do
  IFS=':' read -r service_dir service_name <<< "$service_info"
  if ! run_service_tests "$service_dir" "$service_name"; then
    echo -e "${RED}Commit aborted due to unit test failures.${NC}"
    exit 1
  fi
done

# Run UI tests
if ! run_ui_tests; then
  echo -e "${RED}Commit aborted due to unit test failures.${NC}"
  exit 1
fi

echo -e "${GREEN}✓ All unit tests passed${NC}"
echo ""

# Check if minikube is running
if ! minikube status >/dev/null 2>&1; then
  echo -e "${RED}Error: Minikube is not running.${NC}"
  echo -e "${YELLOW}Please start minikube with: minikube start${NC}"
  echo -e "${YELLOW}Or skip tests with: SKIP_MINIKUBE_TESTS=1 git commit${NC}"
  exit 1
fi

# Check if deploy script exists
if [ ! -f "$DEPLOY_SCRIPT" ]; then
  echo -e "${RED}Error: deploy-minikube.sh not found at $DEPLOY_SCRIPT${NC}"
  exit 1
fi

# Cleanup any existing deployments first
echo -e "${YELLOW}Cleaning up any existing deployments...${NC}"
"$DEPLOY_SCRIPT" --cleanup || true

# Run the deployment script
if "$DEPLOY_SCRIPT"; then
  echo -e "${GREEN}✓ Minikube deployment tests passed${NC}"
  
  # Cleanup after successful test
  echo -e "${YELLOW}Cleaning up test deployment...${NC}"
  "$DEPLOY_SCRIPT" --cleanup || true
  
  exit 0
else
  echo -e "${RED}✗ Minikube deployment tests failed${NC}"
  echo -e "${YELLOW}Commit aborted. Fix the issues and try again.${NC}"
  echo -e "${YELLOW}To skip tests: SKIP_MINIKUBE_TESTS=1 git commit${NC}"
  
  # Cleanup on failure
  "$DEPLOY_SCRIPT" --cleanup || true
  
  exit 1
fi

