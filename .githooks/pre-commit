#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook to run TruffleHog secret scanning and unit tests
# Commit message format validation is handled by the commit-msg hook
# Skip TruffleHog with: SKIP_TRUFFLEHOG=1 git commit

# Get the script directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Run TruffleHog secret scanning
run_trufflehog_scan() {
  echo -e "${YELLOW}Running TruffleHog secret scan...${NC}"
  
  # Check if trufflehog3 is installed
  if ! command -v trufflehog3 >/dev/null 2>&1; then
    echo -e "${RED}Error: TruffleHog3 is not installed${NC}"
    echo -e "${YELLOW}Install it with: pip3 install trufflehog3${NC}"
    exit 1
  fi
  
  # Remove known test key fixture from dependencies to avoid false positives
  rm -f "$REPO_ROOT/ui/node_modules/nssocket/test/fixtures/ryans-key.pem" 2>/dev/null || true
  
  # Run TruffleHog scan with HIGH severity only
  # Use JSON format to parse results easily
  cd "$REPO_ROOT"
  if ! trufflehog3 . --format JSON --severity HIGH > /tmp/trufflehog_results.json 2>&1; then
    # Check if there are actual findings (non-empty JSON array)
    findings=$(cat /tmp/trufflehog_results.json 2>/dev/null | grep -v "^\[\]$" || true)
    if [ -n "$findings" ] && [ "$findings" != "[]" ]; then
      echo -e "${RED}✗ TruffleHog found high severity secrets!${NC}"
      echo -e "${YELLOW}High severity findings:${NC}"
      trufflehog3 . --format TEXT --severity HIGH 2>&1 | head -50
      echo ""
      echo -e "${RED}Commit aborted. Remove secrets before committing.${NC}"
      echo -e "${YELLOW}To skip TruffleHog scan: SKIP_TRUFFLEHOG=1 git commit${NC}"
      rm -f /tmp/trufflehog_results.json 2>/dev/null || true
      exit 1
    fi
  fi

  echo -e "${GREEN}✓ TruffleHog scan passed (no high severity secrets found)${NC}"
  rm -f /tmp/trufflehog_results.json 2>/dev/null || true
  return 0
}

# Run TruffleHog scan first (unless skipped)
if [ "${SKIP_TRUFFLEHOG:-}" != "1" ]; then
  if ! run_trufflehog_scan; then
    exit 1
  fi
  echo ""
else
  echo "Skipping TruffleHog scan (SKIP_TRUFFLEHOG=1)"
fi

echo -e "${YELLOW}Running unit tests before commit...${NC}"

# Run unit tests for Java services
run_service_tests() {
  local service_dir="$1"
  local service_name="$2"
  
  echo -e "${YELLOW}Running unit tests for $service_name service...${NC}"
  cd "$service_dir"
  
  if ! mvn test -q; then
    echo -e "${RED}✗ Unit tests failed for $service_name service${NC}"
    return 1
  fi
  
  echo -e "${GREEN}✓ Unit tests passed for $service_name service${NC}"
  return 0
}

# Run TypeScript type checking for UI
run_ui_typecheck() {
  echo -e "${YELLOW}Running TypeScript type check for UI...${NC}"
  cd "$REPO_ROOT/ui"
  
  if ! npx tsc --noEmit --project tsconfig.app.json; then
    echo -e "${RED}✗ TypeScript type check failed for UI${NC}"
    return 1
  fi
  
  echo -e "${GREEN}✓ TypeScript type check passed for UI${NC}"
  return 0
}

# Run unit tests for UI
run_ui_tests() {
  echo -e "${YELLOW}Running unit tests for UI...${NC}"
  cd "$REPO_ROOT/ui"
  
  if ! npm test -- --passWithNoTests --silent; then
    echo -e "${RED}✗ Unit tests failed for UI${NC}"
    return 1
  fi
  
  echo -e "${GREEN}✓ Unit tests passed for UI${NC}"
  return 0
}

# Run all unit tests
echo -e "${YELLOW}Running unit tests...${NC}"

# Check if Maven is available
if ! command -v mvn >/dev/null 2>&1; then
  echo -e "${RED}Error: Maven (mvn) is not installed${NC}"
  exit 1
fi

# Check if npm is available
if ! command -v npm >/dev/null 2>&1; then
  echo -e "${RED}Error: npm is not installed${NC}"
  exit 1
fi

# Run tests for backend service(s)
SERVICES=(
  "$REPO_ROOT/api/services/ecompoc:ecompoc"
)

for service_info in "${SERVICES[@]}"; do
  IFS=':' read -r service_dir service_name <<< "$service_info"
  if ! run_service_tests "$service_dir" "$service_name"; then
    echo -e "${RED}Commit aborted due to unit test failures.${NC}"
    exit 1
  fi
done

# Run UI type checking
if ! run_ui_typecheck; then
  echo -e "${RED}Commit aborted due to TypeScript type check failures.${NC}"
  exit 1
fi

# Run UI tests
if ! run_ui_tests; then
  echo -e "${RED}Commit aborted due to unit test failures.${NC}"
  exit 1
fi

echo -e "${GREEN}✓ All unit tests passed${NC}"
echo ""

exit 0

