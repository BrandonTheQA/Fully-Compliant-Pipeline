{
	"info": {
		"_postman_id": "helloworld-function-collection",
		"name": "HelloWorld Function API",
		"description": "Collection for testing HelloWorld Azure Function endpoints",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Hello World",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/hello?name=World",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"hello"
					],
					"query": [
						{
							"key": "name",
							"value": "World"
						}
					]
				},
				"description": "Say hello to the world"
			},
			"response": []
		},
		{
			"name": "Hello World POST",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "John Doe"
				},
				"url": {
					"raw": "{{baseUrl}}/api/hello",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"hello"
					]
				},
				"description": "Say hello via POST request"
			},
			"response": []
		},
		{
			"name": "Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/health",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"health"
					]
				},
				"description": "Check application health status and system metrics"
			},
			"response": []
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:7071",
			"type": "string"
		}
	]
}