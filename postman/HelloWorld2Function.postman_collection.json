	"item": [
		{
			"name": "GET Request with Query Parameter",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}?name=Postman",
					"host": [
						"{{baseUrl}}"
					],
					"query": [
						{
							"key": "name",
							"value": "Postman"
						}
					]
				},
				"description": "Test successful GET request with name parameter in query string"
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response body contains expected greeting\", function () {",
							"    pm.expect(pm.response.text()).to.include(\"Hello, Postman! Welcome to Azure Functions!\");",
							"});",
							"",
							"pm.test(\"Response contains version information\", function () {",
							"    pm.expect(pm.response.text()).to.include(\"App: HelloWorld2\");",
							"    pm.expect(pm.response.text()).to.include(\"Version: v2.2.0\");",
							"    pm.expect(pm.response.text()).to.include(\"Build Date: 2024-01-15\");",
							"});",
							"",
							"pm.test(\"Response time is less than 2000ms\", function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);",
							"});",
							"",
							"pm.test(\"Content-Type is text/plain\", function () {",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/plain\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
