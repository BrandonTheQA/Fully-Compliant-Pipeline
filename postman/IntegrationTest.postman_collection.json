			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has all required fields\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('region');",
							"    pm.expect(jsonData).to.have.property('freeShippingThreshold');",
							"    pm.expect(jsonData).to.have.property('currentCartTotal');",
							"    pm.expect(jsonData).to.have.property('remainingAmount');",
							"    pm.expect(jsonData).to.have.property('qualifiesForFreeShipping');",
							"});",
							"",
							"pm.test(\"Cart above threshold qualifies for free shipping\", function () {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.currentCartTotal >= jsonData.freeShippingThreshold) {",
							"        pm.expect(jsonData.qualifiesForFreeShipping).to.be.true;",
							"        pm.expect(jsonData.remainingAmount).to.eql(0);",
							"    }",
							"});",
							"",
							"pm.test(\"Remaining amount is 0 when qualified\", function () {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.qualifiesForFreeShipping) {",
							"        pm.expect(jsonData.remainingAmount).to.eql(0);",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
