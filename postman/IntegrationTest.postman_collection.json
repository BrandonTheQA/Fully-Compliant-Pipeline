							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.userId).to.eql(pm.environment.get('userId'));",
							"});",
							"",
							"pm.test(\"Order has items\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('items');",
							"    pm.expect(jsonData.items).to.be.an('array');",
							"    pm.expect(jsonData.items.length).to.be.at.least(1);",
							"});",
							"",
							"pm.test(\"Order has totalAmount\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('totalAmount');",
							"    pm.expect(jsonData.totalAmount).to.be.a('number');",
							"    pm.expect(jsonData.totalAmount).to.be.above(0);",
							"});",
							"",
							"pm.test(\"Order has status\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('status');",
							"});",
							"",
							"pm.test(\"Order items contain expected products\", function () {",
							"    var jsonData = pm.response.json();",
							"    var productIds = jsonData.items.map(item => item.productId);",
							"    pm.expect(productIds).to.include(pm.environment.get('productId1'));",
							"    pm.expect(productIds).to.include(pm.environment.get('productId2'));",
							"    pm.expect(productIds).to.include(pm.environment.get('productId3'));",
							"});",
							"",
							"pm.test(\"Order total amount is correct\", function () {",
							"    var jsonData = pm.response.json();",
							"    var calculatedTotal = 0;",
							"    jsonData.items.forEach(function(item) {",
							"        calculatedTotal += item.subtotal;",
							"    });",
							"    pm.expect(jsonData.totalAmount).to.eql(calculatedTotal);",
							"});",
							"",
							"pm.test(\"Order has createdAt\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('createdAt');",
							"});"
