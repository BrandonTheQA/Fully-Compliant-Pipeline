		{
			"name": "8. Get Order (Verify)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Order exists and matches created order\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.id).to.eql(pm.environment.get('orderId'));",
							"    pm.expect(jsonData.userId).to.eql(pm.environment.get('userId'));",
							"});",
							"",
							"pm.test(\"Order has all expected items\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.items.length).to.eql(3);",
							"});",
							"",
							"pm.test(\"Order items have correct structure\", function () {",
							"    var jsonData = pm.response.json();",
							"    jsonData.items.forEach(function(item) {",
							"        pm.expect(item).to.have.property('productId');",
							"        pm.expect(item).to.have.property('productName');",
							"        pm.expect(item).to.have.property('quantity');",
							"        pm.expect(item).to.have.property('price');",
							"        pm.expect(item).to.have.property('subtotal');",
							"        pm.expect(item.subtotal).to.eql(item.price * item.quantity);",
							"    });",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{apiBaseUrl}}/orders/{{orderId}}",
					"host": [
						"{{apiBaseUrl}}"
					],
					"path": [
						"orders",
						"{{orderId}}"
					]
				},
				"description": "Retrieves the created order to verify it was created successfully and contains all expected data"
			},
			"response": []
		}
