							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"User exists and matches created user\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.userId).to.eql(pm.environment.get('userId'));",
							"    pm.expect(jsonData.name).to.eql(pm.environment.get('userName'));",
							"    pm.expect(jsonData.email).to.eql(pm.environment.get('userEmail'));",
