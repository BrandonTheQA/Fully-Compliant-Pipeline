		{
			"name": "9. Get Shipping Threshold (Below Threshold)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response has region\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('region');",
							"    pm.expect(jsonData.region).to.be.a('string');",
							"});",
							"",
							"pm.test(\"Response has freeShippingThreshold\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('freeShippingThreshold');",
							"    pm.expect(jsonData.freeShippingThreshold).to.be.a('number');",
							"    pm.expect(jsonData.freeShippingThreshold).to.be.above(0);",
							"    pm.environment.set('freeShippingThreshold', jsonData.freeShippingThreshold);",
							"});",
							"",
							"pm.test(\"Response has currentCartTotal\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('currentCartTotal');",
							"    pm.expect(jsonData.currentCartTotal).to.be.a('number');",
							"});",
							"",
							"pm.test(\"Response has remainingAmount\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('remainingAmount');",
							"    pm.expect(jsonData.remainingAmount).to.be.a('number');",
							"    pm.expect(jsonData.remainingAmount).to.be.at.least(0);",
							"});",
							"",
							"pm.test(\"Response has qualifiesForFreeShipping\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('qualifiesForFreeShipping');",
							"    pm.expect(jsonData.qualifiesForFreeShipping).to.be.a('boolean');",
							"});",
							"",
							"pm.test(\"Cart below threshold does not qualify for free shipping\", function () {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.currentCartTotal < jsonData.freeShippingThreshold) {",
							"        pm.expect(jsonData.qualifiesForFreeShipping).to.be.false;",
							"        pm.expect(jsonData.remainingAmount).to.be.above(0);",
							"    }",
							"});",
							"",
							"pm.test(\"Remaining amount calculation is correct\", function () {",
							"    var jsonData = pm.response.json();",
							"    var expectedRemaining = Math.max(0, jsonData.freeShippingThreshold - jsonData.currentCartTotal);",
							"    pm.expect(jsonData.remainingAmount).to.eql(expectedRemaining);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{apiBaseUrl}}/shipping/threshold?cartTotal=30.00",
					"host": [
						"{{apiBaseUrl}}"
					],
					"path": [
						"shipping",
						"threshold"
					],
					"query": [
						{
							"key": "cartTotal",
							"value": "30.00",
							"description": "Cart total below typical threshold"
						}
					]
				},
				"description": "Gets shipping threshold information for a cart total below the free shipping threshold (matches SCRUM6ShippingBannerTest workflow)"
			},
			"response": []
		},
		{
