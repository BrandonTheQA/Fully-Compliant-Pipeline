<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="add-order-tracking-fields" author="system">
        <addColumn tableName="orders">
            <column name="tracking_number" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="carrier_name" type="NVARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="shipping_address" type="NVARCHAR(500)">
                <constraints nullable="true"/>
            </column>
            <column name="estimated_delivery_date" type="DATETIME2">
                <constraints nullable="true"/>
            </column>
            <column name="shipping_method" type="NVARCHAR(50)">
                <constraints nullable="true"/>
            </column>
            <column name="current_location" type="NVARCHAR(200)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        
        <createIndex indexName="idx_orders_tracking_number" tableName="orders">
            <column name="tracking_number"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
