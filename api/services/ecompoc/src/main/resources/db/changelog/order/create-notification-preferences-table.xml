<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="create-notification-preferences-table" author="system">
        <createTable tableName="notification_preferences">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email_enabled" type="BIT">
                <constraints nullable="false"/>
            </column>
            <column name="sms_enabled" type="BIT">
                <constraints nullable="false"/>
            </column>
            <column name="phone_number" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="notification_frequency" type="NVARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME2">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME2">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <addForeignKeyConstraint 
            baseTableName="notification_preferences" 
            baseColumnNames="user_id"
            constraintName="fk_notification_preferences_user"
            referencedTableName="users"
            referencedColumnNames="id"
            onDelete="CASCADE"/>
            
        <createIndex indexName="idx_notification_preferences_user_id" tableName="notification_preferences">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
